---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { podcast } from '../config';
import { formatearFecha, formatearDuracion } from '../utils/formato';

interface Props {
	episodio: CollectionEntry<'episodios'>;
}

const { episodio } = Astro.props;
const { data } = episodio;
const enlace = `/episodios/${episodio.id}`;
---

<article>
	<Image
		src={data.portada}
		alt={`Portada del episodio ${data.numero} de ${podcast.nombre}: ${data.titulo}`}
		width={300}
	/>

	<h2><a href={enlace}>{data.titulo}</a></h2>
	<p>{formatearFecha(data.fecha)} · {formatearDuracion(data.duracion)}</p>
	<p>{data.descripcion}</p>
	<p>
		Cine: {data.pelicula.titulo} · Series: {data.serie.titulo} · Videojuegos: {data.videojuego.titulo}
	</p>
	<a href={enlace} aria-label={`Escuchar ${data.titulo}`}>Escuchar</a>
</article>
