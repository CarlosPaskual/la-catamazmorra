---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { podcast } from '../config';
import { formatearFecha, formatearDuracion } from '../utils/formato';

interface Props {
	episodio: CollectionEntry<'episodios'>;
}

const { episodio } = Astro.props;
const { data } = episodio;
const enlace = `/episodios/${episodio.id}`;
---

<article>
	<Image
		src={data.portada}
		alt={`Portada del episodio ${data.numero} de ${podcast.nombre}: ${data.titulo}`}
		width={300}
	/>

	<div>
		<h2><a href={enlace}>{data.titulo}</a></h2>
		<p class="detalle">{formatearFecha(data.fecha)} · {formatearDuracion(data.duracion)}</p>
		<p>{data.descripcion}</p>
		<p class="detalle">
			Cine: {data.pelicula.titulo} · Series: {data.serie.titulo} · Videojuegos: {data.videojuego.titulo}
		</p>
		<a class="boton" href={enlace} aria-label={`Escuchar ${data.titulo}`}>Escuchar</a>
	</div>
</article>

<style>
	article {
		display: grid;
		grid-template-columns: 1fr 2fr;
		gap: 1.5rem;
		background: var(--superficie);
		padding: 1.5rem;
	}

	article :global(img) {
		width: 100%;
		height: auto;
	}

	h2 {
		margin-top: 0;
	}

	h2 a {
		color: var(--blanco);
		text-decoration: none;
	}

	h2 a:hover {
		text-decoration: underline;
	}

	@media (max-width: 40rem) {
		article {
			grid-template-columns: 1fr;
		}
	}
</style>
