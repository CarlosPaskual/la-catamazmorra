---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import TarjetaEpisodio from '../components/TarjetaEpisodio.astro';
import { podcast, plataformas } from '../config';
import { obtenerEpisodios } from '../utils/episodios';
import imagenCabecera from '../assets/mazmorra.jpg';
import logo from '../assets/logo.png';

const [ultimo] = await obtenerEpisodios();
---

<Layout>
	<section class="portada">
		<Image
			src={imagenCabecera}
			alt=""
			class="fondo"
			width={1920}
			widths={[800, 1200, 1920, 2560]}
			sizes="100vw"
			loading="eager"
		/>
		<div>
			<h1>
				<Image src={logo} alt={podcast.nombre} width={1000} densities={[1, 2]} loading="eager" />
			</h1>
			<p>{podcast.lema}</p>
			{ultimo && <a class="boton" href={`/episodios/${ultimo.id}`}>Escuchar el último episodio</a>}
		</div>
		<ul aria-label="Escúchanos en">
			{plataformas.map((plataforma) => {
				const Icono = plataforma.icono;
				return (
					<li>
						<a href={plataforma.url}>
							<Icono width={30} height={30} fill="currentColor" aria-hidden="true" />
							<span>{plataforma.nombre}</span>
						</a>
					</li>
				);
			})}
		</ul>
	</section>

	{ultimo && (
		<div class="contenedor">
			<h2>Último episodio</h2>
			<TarjetaEpisodio episodio={ultimo} />
		</div>
	)}
</Layout>

<style>
	.portada {
		position: relative;
		min-height: 90svh;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding: 2rem;
	}

	.fondo {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.portada::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, var(--fondo), transparent);
	}

	.portada > div,
	.portada > ul {
		position: relative;
		z-index: 1;
	}

	h1 {
		margin: 0;
	}

	/* Logo: imagen dentro del h1, para buscadores sigue siendo el título */
	h1 :global(img) {
		display: block;
		width: min(100%, 50rem);
		height: auto;
	}

	.portada ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		justify-content: space-around;
	}

	.portada ul a {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		color: var(--blanco);
		text-decoration: none;
	}

	.portada ul span {
		color: var(--rojo-texto);
		font-size: 0.875rem;
		text-transform: uppercase;
	}

	.portada ul a:hover {
		opacity: 0.7;
	}
</style>
