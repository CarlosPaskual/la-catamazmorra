---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import TarjetaEpisodio from '../components/TarjetaEpisodio.astro';
import { podcast, plataformas } from '../config';
import { obtenerEpisodios } from '../utils/episodios';
import imagenCabecera from '../assets/mazmorra-provisional.svg'; // provisional

const [ultimo] = await obtenerEpisodios();
---

<Layout>
	<section class="portada">
		<Image src={imagenCabecera} alt="" width={1200} loading="eager" />
		<div>
			<h1>{podcast.nombre}</h1>
			<p>{podcast.lema}</p>
			{ultimo && <a class="boton" href={`/episodios/${ultimo.id}`}>Escuchar el último episodio</a>}
		</div>
		<ul aria-label="Escúchanos en">
			{plataformas.map((plataforma) => {
				const Icono = plataforma.icono;
				return (
					<li>
						<a href={plataforma.url} aria-label={`Escúchanos en ${plataforma.nombre}`}>
							<Icono width={30} height={30} fill="currentColor" aria-hidden="true" />
						</a>
					</li>
				);
			})}
		</ul>
	</section>

	{ultimo && (
		<div class="contenedor">
			<h2>Último episodio</h2>
			<TarjetaEpisodio episodio={ultimo} />
		</div>
	)}
</Layout>

<style>
	.portada {
		position: relative;
		min-height: 90svh;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding: 2rem;
	}

	.portada :global(img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.portada::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, var(--fondo), transparent);
	}

	.portada > div,
	.portada > ul {
		position: relative;
		z-index: 1;
	}

	h1 {
		font-family: var(--fuente-logo);
		font-weight: normal;
		font-size: clamp(3rem, 9vw, 7rem);
		margin: 0;
	}

	.portada ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		justify-content: space-around;
	}

	.portada ul a {
		color: var(--blanco);
		text-decoration: none;
	}

	.portada ul a:hover {
		opacity: 0.7;
	}
</style>
