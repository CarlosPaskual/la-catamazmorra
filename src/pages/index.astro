---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import TarjetaEpisodio from '../components/TarjetaEpisodio.astro';
import { podcast, plataformas } from '../config';
import { obtenerEpisodios } from '../utils/episodios';
import imagenCabecera from '../assets/mazmorra-provisional.svg'; // provisional

const [ultimo] = await obtenerEpisodios();
---

<Layout>
	<section>
		<Image src={imagenCabecera} alt="" width={1200} loading="eager" />
		<h1>{podcast.nombre}</h1>
		<p>{podcast.lema}</p>
		{ultimo && <a href={`/episodios/${ultimo.id}`}>Escuchar el último episodio</a>}
	</section>

	<ul aria-label="Escúchanos en">
		{plataformas.map((plataforma) => (
			<li><a href={plataforma.url}>{plataforma.nombre}</a></li>
		))}
	</ul>

	<h2>Último episodio</h2>
	{ultimo && <TarjetaEpisodio episodio={ultimo} />}
</Layout>
