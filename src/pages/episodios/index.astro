---
import Layout from '../../layouts/Layout.astro';
import TarjetaEpisodio from '../../components/TarjetaEpisodio.astro';
import { podcast } from '../../config';
import { obtenerEpisodios } from '../../utils/episodios';

const episodios = await obtenerEpisodios();
---

<Layout titulo="Episodios" descripcion={`Todos los episodios de ${podcast.nombre}.`}>
	<h1>Episodios</h1>
	{episodios.map((episodio) => <TarjetaEpisodio episodio={episodio} />)}
</Layout>
