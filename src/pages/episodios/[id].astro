---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { podcast } from '../../config';
import { formatearFecha, formatearDuracion } from '../../utils/formato';

export async function getStaticPaths() {
	const episodios = await getCollection('episodios');
	return episodios.map((episodio) => ({
		params: { id: episodio.id },
		props: { episodio },
	}));
}

const { episodio } = Astro.props;
const { data } = episodio;
const { Content } = await render(episodio);

const obras = [
	{ seccion: 'Cine', ...data.pelicula },
	{ seccion: 'Series', ...data.serie },
	{ seccion: 'Videojuegos', ...data.videojuego },
];
---

<Layout titulo={data.titulo} descripcion={data.descripcion}>
	<article>
		<Image
			src={data.portada}
			alt={`Portada del episodio ${data.numero} de ${podcast.nombre}: ${data.titulo}`}
			width={600}
		/>

		<h1>{data.titulo}</h1>
		<p>Episodio {data.numero} · {formatearFecha(data.fecha)} · {formatearDuracion(data.duracion)}</p>
		<p>{data.descripcion}</p>

		<audio controls preload="none" src={data.audio}></audio>

		<h2>Capítulos</h2>
		<ol>
			{data.capitulos.map((capitulo) => (
				<li>{capitulo.tiempo} · {capitulo.seccion}</li>
			))}
		</ol>

		<h2>Obras</h2>
		<ul>
			{obras.map((obra) => (
				<li>
					<strong>{obra.seccion}:</strong> {obra.titulo} ({obra.anio}), de {obra.autor}
					{obra.llaves && <span> · {obra.llaves} llaves</span>}
				</li>
			))}
		</ul>

		<h2>Editorial</h2>
		<p>{data.editorial}</p>

		<Content />
	</article>
</Layout>
