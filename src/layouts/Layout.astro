---
import { podcast } from '../config';

interface Props {
	titulo?: string;
	descripcion?: string;
}

const { titulo, descripcion = podcast.lema } = Astro.props;
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={descripcion} />
		<title>{titulo ? `${titulo} | ${podcast.nombre}` : podcast.nombre}</title>
	</head>
	<body>
		<header>
			<nav>
				<ul>
					<li><a href="/">Inicio</a></li>
					<li><a href="/episodios">Episodios</a></li>
					<li><a href="/sobre">Sobre el podcast</a></li>
				</ul>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<footer>
			<p>{podcast.nombre}</p>
		</footer>
	</body>
</html>
