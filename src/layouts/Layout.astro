---
import { podcast } from '../config';
import '../styles/global.css';
import IconoX from '../icons/x.svg';

interface Props {
	titulo?: string;
	descripcion?: string;
}

const { titulo, descripcion = podcast.lema } = Astro.props;

const enlaces = [
	{ texto: 'Inicio', href: '/' },
	{ texto: 'Episodios', href: '/episodios' },
	{ texto: 'Sobre el podcast', href: '/sobre' },
];

// Se calcula al generar la web, así que se actualiza en cada publicación
const anio = new Date().getFullYear();

// Inicio solo con la dirección exacta (todas empiezan por /); el resto también
// en sus subpáginas, para que una ficha de episodio marque «Episodios»
const ruta = Astro.url.pathname;
function esActual(href: string) {
	return href === '/' ? ruta === '/' : ruta.startsWith(href);
}
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={descripcion} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Creepster&family=Oswald:wght@400;600&family=Alegreya:ital,wght@0,400;0,700;1,400&display=swap"
			rel="stylesheet"
		/>
		<title>{titulo ? `${titulo} | ${podcast.nombre}` : podcast.nombre}</title>
	</head>
	<body>
		<header>
			<nav>
				<ul>
					{enlaces.map((enlace) => (
						<li>
							<a href={enlace.href} aria-current={esActual(enlace.href) ? 'page' : undefined}>
								{enlace.texto}
							</a>
						</li>
					))}
				</ul>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<footer>
			<p>© {anio} {podcast.nombre}</p>
			<a href={podcast.x} aria-label={`${podcast.nombre} en X`}>
				<IconoX width={20} height={20} fill="currentColor" aria-hidden="true" />
			</a>
		</footer>
	</body>
</html>

<style>
	header {
		background: var(--negro);
	}

	ul {
		list-style: none;
		margin: 0;
		padding: 1rem;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 3rem;
	}

	nav a {
		font-family: var(--fuente-titulos);
		text-decoration: none;
		text-transform: uppercase;
	}

	nav a[aria-current='page'],
	nav a:hover {
		text-decoration: underline;
		text-underline-offset: 0.4em;
	}

	main {
		flex: 1;
	}

	footer {
		background: var(--negro);
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 1rem;
		padding: 1.5rem;
		margin-top: 3rem;
		color: var(--gris);
		font-size: 0.9rem;
	}

	footer p {
		margin: 0;
	}

	footer a {
		color: var(--gris);
		display: flex;
	}

	footer a:hover {
		color: var(--blanco);
	}
</style>
